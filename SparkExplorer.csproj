<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SparkExplorer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MQTT client with TCP, WebSocket and TLS support -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <!-- Material Design component library, includes the time-series line chart -->
    <PackageReference Include="MudBlazor" Version="9.10.0" />
  </ItemGroup>

</Project>

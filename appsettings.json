{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Transport": "Tcp",
    "Host": "localhost",
    "Port": 1883,
    "WebSocketUri": "ws://localhost:9001",
    "UseTls": false,
    "AllowUntrustedCertificates": false,
    "ProtocolVersion": 4,
    "Subscriptions": "#, $SYS/#",
    "SubscribeQos": 0
  }
}

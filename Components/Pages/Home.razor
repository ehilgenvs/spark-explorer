@page "/"
@implements IDisposable
@inject MqttSession Session
@inject BrokerStore Store
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Spark Explorer</PageTitle>

<MudThemeProvider @ref="_themeProvider" Theme="AppTheme.Theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app">
    <MudAppBar Fixed="false" Dense="true" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.Hub" Class="mr-2" />
        <MudText Typo="Typo.h6">Spark Explorer</MudText>
        <MudSpacer />
        <MudTooltip Text="@Session.StatusText">
            <MudChip T="string" Size="Size.Small" Color="StatusColor" Variant="Variant.Filled" Icon="@StatusIcon"
                     Class="@(Session.State == ConnState.Disconnected ? "status-chip idle" : "status-chip")">
                @Session.StatusText
            </MudChip>
        </MudTooltip>
        <MudButton Color="Color.Inherit" OnClick="ToggleDemo"
                   StartIcon="@(Session.DemoRunning ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)">
            @(Session.DemoRunning ? "Stop demo" : "Start demo")
        </MudButton>
        <MudTooltip Text="@(_isDark ? "Light theme" : "Dark theme")">
            <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="() => _isDark = !_isDark" aria-label="Toggle dark theme" />
        </MudTooltip>
    </MudAppBar>

    <MudPaper Square="true" Elevation="0" Class="connbar">
        <div class="conn-row">
            <MudSelect T="string" Value="_brokerId" ValueChanged="SelectBroker" Label="Broker" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Disabled="Busy" Class="f-broker">
                @foreach (var b in _brokers)
                {
                    <MudSelectItem Value="@b.Id">@b.Name</MudSelectItem>
                }
            </MudSelect>
            <div class="broker-summary">
                <span class="mono">@S.Describe()</span>
                @if (S.UseTls)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock"
                             Color="@(S.Tls.AllowUntrustedCertificates ? Color.Warning : Color.Success)">
                        @(S.Tls.AllowUntrustedCertificates ? "TLS, any certificate" : "TLS")
                    </MudChip>
                }
                @if (!string.IsNullOrEmpty(S.Username))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Person">@S.Username</MudChip>
                }
            </div>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="@(Busy ? Color.Default : Color.Primary)" OnClick="ToggleConnect"
                       StartIcon="@(Busy ? Icons.Material.Filled.LinkOff : Icons.Material.Filled.Link)">
                @(Busy ? "Disconnect" : "Connect")
            </MudButton>
            <MudTooltip Text="Edit this broker's settings">
                <MudIconButton Icon="@Icons.Material.Filled.Settings" OnClick="EditBroker" Disabled="Busy" aria-label="Edit broker" />
            </MudTooltip>
            <MudTooltip Text="Add a broker">
                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="NewBroker" Disabled="Busy" aria-label="Add broker" />
            </MudTooltip>
        </div>
    </MudPaper>

    <Workspace @ref="_workspace" Session="Session" />
</div>

@code {
    private MudThemeProvider? _themeProvider;
    private Workspace? _workspace;
    private bool _isDark;
    private List<ConnectionSettings> _brokers = new();
    private string? _brokerId;
    // Passwords typed for brokers that don't save them; kept for this browser tab only.
    private readonly Dictionary<string, (string? Password, string? CertificatePassword)> _secrets = new();

    private ConnectionSettings S => Session.Settings;
    private bool Busy => Session.State is ConnState.Connected or ConnState.Connecting or ConnState.Reconnecting;

    private Color StatusColor => Session.State switch
    {
        ConnState.Connected => Color.Success,
        ConnState.Connecting or ConnState.Reconnecting => Color.Warning,
        ConnState.Error => Color.Error,
        _ => Color.Default,
    };

    private string StatusIcon => Session.State switch
    {
        ConnState.Connected => Icons.Material.Filled.CloudDone,
        ConnState.Connecting or ConnState.Reconnecting => Icons.Material.Filled.CloudSync,
        ConnState.Error => Icons.Material.Filled.CloudOff,
        _ => Icons.Material.Outlined.Cloud,
    };

    protected override void OnInitialized()
    {
        Session.StatusChanged += OnSessionChanged;
        Store.Changed += OnStoreChanged;
        _brokers = Store.All;
        _brokerId = _brokers.FirstOrDefault(b => b.Id == S.Id)?.Id ?? _brokers.FirstOrDefault()?.Id;
        if (Store.LastError != null) Snackbar.Add(Store.LastError, Severity.Error);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider != null)
        {
            _isDark = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    // Status changes arrive on MQTT threads; only they re-render this part of the page.
    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    // Another tab saved or deleted a broker.
    private void OnStoreChanged() => InvokeAsync(() =>
    {
        _brokers = Store.All;
        StateHasChanged();
    });

    private void SelectBroker(string id)
    {
        var b = Store.Get(id);
        if (b == null) return;
        if (_secrets.TryGetValue(id, out var secret))
        {
            b.Password ??= secret.Password;
            b.Tls.ClientCertificatePassword ??= secret.CertificatePassword;
        }
        _brokerId = id;
        Session.Settings = b;
    }

    private async Task ToggleConnect()
    {
        if (Busy) await Session.DisconnectAsync();
        else await Session.ConnectAsync();
    }

    private Task EditBroker() => OpenBrokerDialog(S.Clone(), isNew: false);

    private Task NewBroker()
    {
        var b = new ConnectionSettings { Name = "New broker", Subscriptions = S.Subscriptions };
        return OpenBrokerDialog(b, isNew: true);
    }

    private async Task OpenBrokerDialog(ConnectionSettings profile, bool isNew)
    {
        var parameters = new DialogParameters<BrokerDialog>
        {
            { x => x.Profile, profile },
            { x => x.IsNew, isNew },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await Dialogs.ShowAsync<BrokerDialog>(isNew ? "Add broker" : "Broker settings", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BrokerDialogResult r) return;

        try
        {
            if (r.Deleted)
            {
                Store.Delete(r.Profile.Id);
                _secrets.Remove(r.Profile.Id);
                _brokers = Store.All;
                if (_brokers.Count == 0) Store.Save(new ConnectionSettings());
                _brokers = Store.All;
                SelectBroker(_brokers[0].Id);
                Snackbar.Add($"Deleted {r.Profile.Name}", Severity.Info);
                return;
            }

            Store.Save(r.Profile);
            if (!r.Profile.SavePasswords) _secrets[r.Profile.Id] = (r.Profile.Password, r.Profile.Tls.ClientCertificatePassword);
            else _secrets.Remove(r.Profile.Id);
            _brokers = Store.All;
            _brokerId = r.Profile.Id;
            Session.Settings = r.Profile.Clone();
            Snackbar.Add($"Saved {r.Profile.Name}", Severity.Success);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Could not save to {Store.FilePath}: {ex.Message}", Severity.Error);
            Session.Settings = r.Profile.Clone();
        }

        if (r.Connect) await Session.ConnectAsync();
    }

    private void ToggleDemo()
    {
        if (Session.DemoRunning)
        {
            Session.StopDemo();
            return;
        }
        Session.StartDemo();
        _workspace?.ShowDemoTopic();
    }

    public void Dispose()
    {
        Session.StatusChanged -= OnSessionChanged;
        Store.Changed -= OnStoreChanged;
    }
}

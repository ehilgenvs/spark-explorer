@page "/"
@implements IAsyncDisposable
@inject MqttSession Session

<PageTitle>Spark Explorer</PageTitle>

<MudThemeProvider @ref="_themeProvider" Theme="AppTheme.Theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app">
    <MudAppBar Fixed="false" Dense="true" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.Hub" Class="mr-2" />
        <MudText Typo="Typo.h6">Spark Explorer</MudText>
        <MudSpacer />
        <MudTooltip Text="@Session.StatusText">
            <MudChip T="string" Size="Size.Small" Color="StatusColor" Variant="Variant.Filled" Icon="@StatusIcon" Class="@(Session.State == ConnState.Disconnected ? "status-chip idle" : "status-chip")">
                @Session.StatusText
            </MudChip>
        </MudTooltip>
        <MudButton Color="Color.Inherit" OnClick="ToggleDemo"
                   StartIcon="@(Session.DemoRunning ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)">
            @(Session.DemoRunning ? "Stop demo" : "Start demo")
        </MudButton>
        <MudTooltip Text="@(_isDark ? "Light theme" : "Dark theme")">
            <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="() => _isDark = !_isDark" aria-label="Toggle dark theme" />
        </MudTooltip>
    </MudAppBar>

    <MudPaper Square="true" Elevation="0" Class="connbar">
        <div class="conn-row">
            <MudSelect T="TransportKind" @bind-Value="S.Transport" Label="Transport" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Disabled="Busy" Class="f-transport">
                <MudSelectItem Value="TransportKind.Tcp">TCP</MudSelectItem>
                <MudSelectItem Value="TransportKind.WebSocket">WebSocket</MudSelectItem>
            </MudSelect>
            @if (S.Transport == TransportKind.Tcp)
            {
                <MudTextField T="string" @bind-Value="S.Host" Label="Host" Placeholder="broker host or IP" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Disabled="Busy" Class="f-host" />
                <MudNumericField T="int" @bind-Value="S.Port" Label="Port" Min="1" Max="65535" HideSpinButtons="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="Busy" Class="f-port" />
            }
            else
            {
                <MudTextField T="string" @bind-Value="S.WebSocketUri" Label="WebSocket URL" Placeholder="ws://host:9001/mqtt"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="Busy" Class="f-url" />
            }
            <MudCheckBox T="bool" Value="S.UseTls" ValueChanged="TlsChanged" Label="TLS" Disabled="Busy" />
            <MudButton Variant="Variant.Filled" Color="@(Busy ? Color.Default : Color.Primary)" OnClick="ToggleConnect"
                       StartIcon="@(Busy ? Icons.Material.Filled.LinkOff : Icons.Material.Filled.Link)">
                @(Busy ? "Disconnect" : "Connect")
            </MudButton>
            <MudTooltip Text="Connection options">
                <MudIconButton Icon="@Icons.Material.Filled.Tune" Color="@(_showOptions ? Color.Primary : Color.Default)"
                               OnClick="() => _showOptions = !_showOptions" aria-label="Connection options" />
            </MudTooltip>
        </div>
        <MudCollapse Expanded="_showOptions">
            <div class="conn-row options">
                <MudTextField T="string" @bind-Value="S.Subscriptions" Label="Subscribe to" HelperText="Comma-separated topic filters"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="Busy" Class="f-subs" />
                <MudTextField T="string" @bind-Value="S.ClientId" Label="Client ID" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="Busy" />
                <MudTextField T="string" @bind-Value="S.Username" Label="Username" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="Busy" />
                <MudTextField T="string" @bind-Value="S.Password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Disabled="Busy" />
                <MudSelect T="int" @bind-Value="S.ProtocolVersion" Label="MQTT version" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Disabled="Busy" Class="f-small">
                    <MudSelectItem Value="4">3.1.1</MudSelectItem>
                    <MudSelectItem Value="5">5.0</MudSelectItem>
                </MudSelect>
                <MudSelect T="int" @bind-Value="S.SubscribeQos" Label="QoS" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Disabled="Busy" Class="f-small">
                    <MudSelectItem Value="0">0</MudSelectItem>
                    <MudSelectItem Value="1">1</MudSelectItem>
                    <MudSelectItem Value="2">2</MudSelectItem>
                </MudSelect>
                <MudCheckBox T="bool" @bind-Value="S.AllowUntrustedCertificates" Label="Accept untrusted TLS certificates" Disabled="Busy" />
            </div>
        </MudCollapse>
    </MudPaper>

    <div class="workspace">
        <MudPaper Square="true" Elevation="0" Class="side">
            <div class="sidebar-top">
                <MudTextField T="string" @bind-Value="_filter" Immediate="true" DebounceInterval="150" Placeholder="Filter topics"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                <MudTooltip Text="@(_paused ? "Resume refreshing" : "Pause refreshing (messages are still recorded)")">
                    <MudIconButton Icon="@(_paused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)"
                                   Color="@(_paused ? Color.Warning : Color.Default)" OnClick="TogglePause" aria-label="Pause" />
                </MudTooltip>
                <MudTooltip Text="Forget all received messages">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" OnClick="Clear" aria-label="Clear" />
                </MudTooltip>
            </div>
            <div class="tree" role="tree">
                @if (Session.Topics.Count == 0)
                {
                    <div class="empty">
                        <MudText Typo="Typo.subtitle2">No messages yet</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Choose TCP or WebSocket, enter your broker's address and press Connect.
                            Or press Start demo to see simulated plant traffic with Sparkplug B nodes.
                        </MudText>
                    </div>
                }
                else
                {
                    var rows = BuildRows();
                    if (rows.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="empty mud-text-secondary">No topics match this filter.</MudText>
                    }
                    <Virtualize Items="rows" ItemSize="28" OverscanCount="30" Context="r">
                        <TreeRow Row="r.Node" Depth="r.Depth" Open="r.Open" Selected="@(r.Node.Path == _selected)"
                                 OnSelect="RowClick" OnToggle="Toggle" />
                    </Virtualize>
                }
            </div>
        </MudPaper>

        <div class="right">
            <MudTabs @bind-ActivePanelIndex="_tabIndex" Elevation="0" Class="tabs" Border="false">
                <MudTabPanel Text="Topic" Icon="@Icons.Material.Filled.Article">
                    <div class="tab-body">
                    <TopicDetails Session="Session" Topic="SelectedTopic" Selected="_selectedMsg" SelectedChanged="m => _selectedMsg = m"
                                  Format="@_format" FormatChanged="f => _format = f" />
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="Sparkplug nodes" Icon="@Icons.Material.Filled.AccountTree">
                    <div class="tab-body"><SparkplugNodes Session="Session" Collapsed="_collapsed" /></div>
                </MudTabPanel>
                <MudTabPanel Text="Publish" Icon="@Icons.Material.Filled.Send">
                    <div class="tab-body"><PublishPanel Session="Session" SelectedTopic="@_selected" /></div>
                </MudTabPanel>
            </MudTabs>

            @if (Session.Plotted.Count > 0)
            {
                <ChartPanel Session="Session" />
            }
        </div>
    </div>

    <footer class="statusbar">
        <span>Topics <b>@Session.Topics.Count</b></span>
        <span>Messages <b>@Session.TotalMessages</b></span>
        <span>Rate <b>@Session.Rate</b>/s</span>
        <span>Sparkplug edge nodes <b>@Session.SpNodes.Values.Count(n => n.Device == null)</b></span>
        <span>Data points <b>@Session.Series.Count</b></span>
        @if (Session.Dropped > 0)
        {
            <span class="mud-error-text">Dropped <b>@Session.Dropped</b> (the view could not keep up)</span>
        }
        @if (_paused)
        {
            <span class="mud-warning-text"><b>View paused</b>, messages are still recorded</span>
        }
    </footer>
</div>

@code {
    private const int MaxRows = 20_000;

    private readonly record struct Row(TreeNode Node, int Depth, bool Open);

    private readonly CancellationTokenSource _cts = new();
    private readonly HashSet<string> _expanded = new();
    private readonly HashSet<string> _collapsed = new();
    private MudThemeProvider? _themeProvider;
    private bool _isDark;
    private string _filter = "";
    private string? _selected;
    private MqttMessage? _selectedMsg;
    private string _format = "auto";
    private int _tabIndex;
    private bool _paused;
    private bool _showOptions;

    private ConnectionSettings S => Session.Settings;
    private bool Busy => Session.State is ConnState.Connected or ConnState.Connecting or ConnState.Reconnecting;

    private Color StatusColor => Session.State switch
    {
        ConnState.Connected => Color.Success,
        ConnState.Connecting or ConnState.Reconnecting => Color.Warning,
        ConnState.Error => Color.Error,
        _ => Color.Default,
    };

    private string StatusIcon => Session.State switch
    {
        ConnState.Connected => Icons.Material.Filled.CloudDone,
        ConnState.Connecting or ConnState.Reconnecting => Icons.Material.Filled.CloudSync,
        ConnState.Error => Icons.Material.Filled.CloudOff,
        _ => Icons.Material.Outlined.Cloud,
    };

    private TopicData? SelectedTopic => _selected != null && Session.Topics.TryGetValue(_selected, out var t) ? t : null;

    protected override void OnInitialized()
    {
        Session.PlotsChanged += OnPlotsChanged;
        _ = RefreshLoopAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider != null)
        {
            _isDark = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    private void OnPlotsChanged() => InvokeAsync(StateHasChanged);

    // Applies incoming messages on the renderer's sync context a few times per second.
    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(400));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await InvokeAsync(() =>
                {
                    if (Session.Drain() && !_paused) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task ToggleConnect()
    {
        if (Busy) await Session.DisconnectAsync();
        else await Session.ConnectAsync();
    }

    private void TlsChanged(bool value)
    {
        S.UseTls = value;
        if (S.Transport == TransportKind.Tcp)
        {
            if (value && S.Port == 1883) S.Port = 8883;
            else if (!value && S.Port == 8883) S.Port = 1883;
        }
        else if (value && S.WebSocketUri.StartsWith("ws://", StringComparison.OrdinalIgnoreCase))
        {
            S.WebSocketUri = "wss://" + S.WebSocketUri[5..];
        }
        else if (!value && S.WebSocketUri.StartsWith("wss://", StringComparison.OrdinalIgnoreCase))
        {
            S.WebSocketUri = "ws://" + S.WebSocketUri[6..];
        }
    }

    private void ToggleDemo()
    {
        if (Session.DemoRunning)
        {
            Session.StopDemo();
            return;
        }
        Session.StartDemo();
        if (_selected == null)
        {
            _selected = DemoGenerator.FirstTopic;
            var parts = _selected.Split('/');
            for (var i = 1; i < parts.Length; i++) _expanded.Add(string.Join('/', parts, 0, i));
            _expanded.Add("factory");
            _expanded.Add("factory/line1");
        }
    }

    private void TogglePause() => _paused = !_paused;

    private void Clear()
    {
        Session.Clear();
        _selected = null;
        _selectedMsg = null;
    }

    private void Toggle(TreeNode n)
    {
        if (n.Children.Count == 0) return;
        if (!_expanded.Remove(n.Path)) _expanded.Add(n.Path);
    }

    private void RowClick(TreeNode n)
    {
        if (n.Topic != null)
        {
            if (_selected == n.Path) Toggle(n);
            _selected = n.Path;
            _selectedMsg = null;
            _tabIndex = 0;
        }
        else Toggle(n);
    }

    private List<Row> BuildRows()
    {
        var rows = new List<Row>();
        HashSet<string>? visible = null;
        var f = (_filter ?? "").Trim();
        if (f.Length > 0)
        {
            visible = new HashSet<string>();
            foreach (var topic in Session.Topics.Keys)
            {
                if (!topic.Contains(f, StringComparison.OrdinalIgnoreCase)) continue;
                var parts = topic.Split('/');
                for (var i = 1; i <= parts.Length; i++) visible.Add(string.Join('/', parts, 0, i));
            }
        }

        void Walk(TreeNode node, int depth)
        {
            foreach (var c in node.SortedChildren)
            {
                if (rows.Count >= MaxRows) return;
                if (visible != null && !visible.Contains(c.Path)) continue;
                var open = visible != null || _expanded.Contains(c.Path);
                rows.Add(new Row(c, depth, open));
                if (open && c.Children.Count > 0) Walk(c, depth + 1);
            }
        }
        Walk(Session.Root, 0);
        return rows;
    }

    public ValueTask DisposeAsync()
    {
        Session.PlotsChanged -= OnPlotsChanged;
        _cts.Cancel();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <HeadOutlet @rendermode="RenderModeServer" />
</head>
<body>
    <Routes @rendermode="RenderModeServer" />
    <div id="blazor-error-ui">
        The connection to the server was interrupted or an error occurred.
        <a href="" class="reload">Reload</a>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>

@code {
    // Prerendering is off so the MQTT session is created once per browser tab.
    private static readonly IComponentRenderMode RenderModeServer = new InteractiveServerRenderMode(prerender: false);
}
